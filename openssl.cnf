[ req ]
default_bits       = 2048
default_md         = sha256
prompt             = no
distinguished_name = dn
req_extensions     = req_ext

[ dn ]
CN = 127.0.0.1

[ req_ext ]
subjectAltName = @alt_names

[ alt_names ]
IP.1 = 127.0.0.1
IP.2 = 192.168.1.50
IP.3 = 192.168.1.51
# Add more IPs as needed:
# IP.4 = 192.168.1.52
# IP.5 = 10.0.0.2

